{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/hijimasa/unirobolab/contract/policy_contract.schema.json",
  "title": "UniRoboLab policy contract (v0 draft)",
  "description": "Single source of truth for how a policy observes and acts. Both the training environment and the generated ROS 2 node are derived from this.",
  "type": "object",
  "required": [
    "contract_version",
    "robot",
    "control",
    "observations",
    "actions",
    "policy"
  ],
  "additionalProperties": false,
  "properties": {
    "contract_version": {
      "const": 0
    },
    "name": {
      "type": "string"
    },
    "robot": {
      "type": "object",
      "required": [
        "urdf",
        "joints"
      ],
      "additionalProperties": false,
      "properties": {
        "urdf": {
          "type": "string",
          "description": "Path to the URDF used in both training and deployment."
        },
        "joints": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          },
          "description": "Canonical joint order. Every observation/action term that refers to joints uses this order."
        }
      }
    },
    "control": {
      "type": "object",
      "required": [
        "policy_rate_hz"
      ],
      "additionalProperties": false,
      "properties": {
        "policy_rate_hz": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "sim_dt_s": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "Physics step used in training. The generated node checks that the real controller rate matches policy_rate_hz."
        },
        "action_latency_steps": {
          "type": "integer",
          "minimum": 0,
          "default": 0
        }
      }
    },
    "observations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/observation_term"
      },
      "description": "Concatenated in this order to form the policy input."
    },
    "actions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/action_term"
      },
      "description": "Policy output is split in this order."
    },
    "policy": {
      "type": "object",
      "required": [
        "onnx",
        "input_name",
        "output_name"
      ],
      "additionalProperties": false,
      "properties": {
        "onnx": {
          "type": "string"
        },
        "input_name": {
          "type": "string"
        },
        "output_name": {
          "type": "string"
        },
        "history_length": {
          "type": "integer",
          "minimum": 1,
          "default": 1
        }
      }
    },
    "ros": {
      "type": "object",
      "description": "How the generated ROS 2 node reaches the robot. Defaults derive from namespace.",
      "additionalProperties": false,
      "properties": {
        "namespace": {
          "type": "string",
          "description": "Robot namespace, e.g. ServoDemo. Topics default to /<namespace>/..."
        },
        "joint_states_topic": {
          "type": "string",
          "description": "Default /<namespace>/joint_states"
        },
        "command_topic": {
          "type": "string",
          "description": "Default /<namespace>/joint_command (sensor_msgs/JointState, as the simulator and topic_based_ros2_control expect)"
        },
        "command_mode": {
          "enum": [
            "joint_state_topic",
            "ros2_control_commands"
          ],
          "default": "joint_state_topic",
          "description": "joint_state_topic publishes JointState on command_topic; ros2_control_commands publishes Float64MultiArray on /<namespace>/<controller_name>/commands"
        },
        "controller_name": {
          "type": "string",
          "description": "ros2_control controller receiving the commands (command_mode=ros2_control_commands)"
        },
        "goal_topic": {
          "type": "string",
          "description": "Float64MultiArray feeding the 'command' observation. Default /<namespace>/policy/command. Status/debug topics live next to it."
        },
        "ground_truth_topic": {
          "type": "string",
          "description": "geometry_msgs/PoseStamped with the base pose (the simulator's ground truth; on a real robot, odometry/localization). Needed when the contract observes base_* / projected_gravity / imu_orientation / base_goal_xy. Default /<namespace>/ground_truth"
        }
      }
    }
  },
  "$defs": {
    "unit": {
      "enum": [
        "rad",
        "deg",
        "rad/s",
        "deg/s",
        "m",
        "m/s",
        "m/s^2",
        "N",
        "N*m",
        "unitless"
      ]
    },
    "observation_term": {
      "type": "object",
      "required": [
        "name",
        "source"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string"
        },
        "source": {
          "enum": [
            "joint_position",
            "joint_velocity",
            "joint_effort",
            "base_lin_vel",
            "base_ang_vel",
            "projected_gravity",
            "imu_orientation",
            "last_action",
            "command",
            "custom",
            "base_goal_xy"
          ],
          "description": "base_* / projected_gravity / imu_orientation are in the body frame (ROS axes). base_goal_xy (size 2) is the task goal on the ground expressed in the body frame; the deployed node builds it from the goal topic (world x, y) and the robot pose."
        },
        "joints": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Subset of robot.joints, in robot.joints order. Omit for all joints."
        },
        "unit": {
          "$ref": "#/$defs/unit"
        },
        "scale": {
          "type": "number",
          "default": 1.0,
          "description": "Applied after deadband: value*scale + offset, then clip."
        },
        "offset": {
          "type": "number",
          "default": 0.0
        },
        "clip": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 2,
          "maxItems": 2
        },
        "deadband": {
          "type": "number",
          "minimum": 0,
          "description": "Values with |x| below this are zeroed before scaling. Use for sensors that never rest at exactly zero."
        },
        "ros_topic": {
          "type": "string",
          "description": "Override of the ROS 2 source topic in the generated node."
        },
        "size": {
          "type": "integer",
          "minimum": 1,
          "description": "Required for source=command/custom. Joint sources take their size from joints; last_action from the action layout."
        }
      },
      "description": "Processing order: deadband -> *scale + offset -> clip."
    },
    "action_term": {
      "type": "object",
      "required": [
        "name",
        "target",
        "mode"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string"
        },
        "target": {
          "enum": [
            "joints",
            "base_twist",
            "custom"
          ]
        },
        "joints": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "mode": {
          "enum": [
            "position",
            "velocity",
            "effort"
          ]
        },
        "unit": {
          "$ref": "#/$defs/unit"
        },
        "scale": {
          "type": "number",
          "default": 1.0
        },
        "offset": {
          "type": "number",
          "default": 0.0
        },
        "clip": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 2,
          "maxItems": 2
        },
        "ros2_control_interface": {
          "type": "string",
          "description": "e.g. position_controllers/JointGroupPositionController"
        },
        "size": {
          "type": "integer",
          "minimum": 1,
          "description": "Required for target=custom; base_twist defaults to 2."
        }
      },
      "description": "Processing order on the raw policy output: clip -> *scale + offset -> publish."
    }
  }
}
