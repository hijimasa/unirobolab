{
  "contract_version": 0,
  "name": "diffbot_rl",
  "robot": {
    "urdf": "diffbot_description/robots/diffbot.urdf.xacro",
    "joints": ["left_wheel_joint", "right_wheel_joint"]
  },
  "control": {
    "policy_rate_hz": 10,
    "sim_dt_s": 0.02,
    "action_latency_steps": 0
  },
  "observations": [
    { "name": "v_body",  "source": "base_lin_vel",     "unit": "m/s",   "scale": 1.0 },
    { "name": "w_body",  "source": "base_ang_vel",     "unit": "rad/s", "scale": 0.5 },
    { "name": "goal",    "source": "base_goal_xy",     "unit": "m",     "scale": 0.5, "clip": [-3.0, 3.0] },
    { "name": "wheel_w", "source": "joint_velocity",   "unit": "rad/s", "scale": 0.1 },
    { "name": "prev_a",  "source": "last_action" }
  ],
  "actions": [
    { "name": "wheel_cmd", "target": "joints", "mode": "velocity", "unit": "rad/s",
      "scale": 10.0, "clip": [-1.0, 1.0],
      "ros2_control_interface": "velocity_controllers/JointGroupVelocityController" }
  ],
  "policy": {
    "onnx": "../../generated/runs/diffbot_rl/policy.onnx",
    "input_name": "obs",
    "output_name": "actions",
    "history_length": 1
  },
  "ros": {
    "namespace": "diffbot",
    "command_mode": "joint_state_topic",
    "ground_truth_topic": "/diffbot/ground_truth"
  }
}
