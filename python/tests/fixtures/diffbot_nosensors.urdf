<robot name="diffbot">
  <material name="gray">
    <color rgba="0.5 0.5 0.5 0.2" />
  </material>
  <material name="ball">
    <color rgba="0.5 0.5 0.5 0.2" />
  </material>
  <material name="white">
    <color rgba="1.0 1.0 1.0 1.0" />
  </material>
  <collision_material name="wheel">
    <friction dynamic="1.0" static="1.0" />
    <contact_offset value="0.02" />
  </collision_material>
  <collision_material name="ball">
    <friction dynamic="0.0" static="0.0" />
  </collision_material>
  
  <buoyancy_material name="light_material">
    <density value="0.5" />
    
  </buoyancy_material>
  <buoyancy_material name="heavy_material">
    <density value="2.0" />
    
  </buoyancy_material>
  
  <hydrodynamics>
    <water_density>1027</water_density>
    <velocity_reference>1.0</velocity_reference>
    <pressure_drag>
      <C_PD1>10</C_PD1>
      <C_PD2>10</C_PD2>
      <f_P>0.5</f_P>
    </pressure_drag>
    <suction_drag>
      <C_SD1>10</C_SD1>
      <C_SD2>10</C_SD2>
      <f_S>0.5</f_S>
    </suction_drag>
    <slamming>
      <power>2</power>
      <max_acceleration>10</max_acceleration>
      <multiplier>1</multiplier>
    </slamming>
  </hydrodynamics>
  <link name="base_link">
    <inertial>
      <origin rpy="0 0 0" xyz="0 0 0" />
      <mass value="0.01" />
      <inertia ixx="0.0001" ixy="0.0" ixz="0.0" iyy="0.0001" iyz="0.0" izz="0.0001" />
    </inertial>
  </link>
  <joint name="body_joint" type="fixed">
    <parent link="base_link" />
    <child link="body_link" />
    <origin rpy="0 0 0" xyz="-0.07 0 0.07" />
  </joint>
  <link name="body_link">
    <inertial>
      <origin rpy="0 0 0" xyz="0 0 0" />
      <mass value="1.0" />
      <inertia ixx="0.001" ixy="0.0" ixz="0.0" iyy="0.001" iyz="0.0" izz="0.001" />
    </inertial>
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0" />
      <geometry>
        <box size="0.24 0.18 0.06" />
      </geometry>
      <material name="gray" />
    </visual>
    <collision>
      <origin rpy="0 0 0" xyz="0 0 0" />
      <buoyancy_material name="light_material" />
      
      <hydrodynamics>
        <pressure_drag>
          <C_PD1>15</C_PD1>
          <C_PD2>20</C_PD2>
          <f_P>0.5</f_P>
        </pressure_drag>
      </hydrodynamics>
      <geometry>
        <box size="0.24 0.178 0.06" />
      </geometry>
    </collision>
  </link>
  <joint name="left_wheel_joint" type="continuous">
    <axis xyz="0 0 1" />
    <parent link="body_link" />
    <child link="left_wheel_link" />
    <origin rpy="-1.5707963267948966 0 0" xyz="0.07 0.1 -0.02" />
    <drive damping="30000.0" stiffness="0.0" />
    <limit effort="100.0" velocity="100.0" />
  </joint>
  <link name="left_wheel_link">
    <inertial>
      <origin rpy="0 0 0" xyz="0 0 0" />
      <mass value="0.1" />
      <inertia ixx="0.0001" ixy="0.0" ixz="0.0" iyy="0.0001" iyz="0.0" izz="0.0001" />
    </inertial>
    <visual>
      <geometry>
        <cylinder length="0.02" radius="0.05" />
      </geometry>
      <material name="gray" />
    </visual>
    <collision>
      <buoyancy_material name="light_material" />
      <geometry>
        <cylinder length="0.02" radius="0.05" />
      </geometry>
      <collision_material name="wheel" />
    </collision>
  </link>
  <joint name="right_wheel_joint" type="continuous">
    <axis xyz="0 0 1" />
    <parent link="body_link" />
    <child link="right_wheel_link" />
    <origin rpy="-1.5707963267948966 0 0" xyz="0.07 -0.1 -0.02" />
    <drive damping="30000.0" stiffness="0.0" />
    <limit effort="100.0" velocity="100.0" />
  </joint>
  <link name="right_wheel_link">
    <inertial>
      <origin rpy="0 0 0" xyz="0 0 0" />
      <mass value="0.1" />
      <inertia ixx="0.0001" ixy="0.0" ixz="0.0" iyy="0.0001" iyz="0.0" izz="0.0001" />
    </inertial>
    <visual>
      <geometry>
        <cylinder length="0.02" radius="0.05" />
      </geometry>
      <material name="gray" />
    </visual>
    <collision>
      <buoyancy_material name="light_material" />
      <geometry>
        <cylinder length="0.02" radius="0.05" />
      </geometry>
      <collision_material name="wheel" />
    </collision>
  </link>
  <joint name="ball_joint" type="fixed">
    <parent link="body_link" />
    <child link="ball_link" />
    <origin rpy="0 0 0" xyz="-0.07 0 -0.05" />
  </joint>
  <link name="ball_link">
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0" />
      <geometry>
        <sphere radius="0.02" />
      </geometry>
      <material name="ball" />
    </visual>
    <collision>
      <origin rpy="0 0 0" xyz="0 0 0" />
      <buoyancy_material name="light_material" />
      <geometry>
        <sphere radius="0.02" />
      </geometry>
      <collision_material name="ball" />
    </collision>
    <inertial>
      <origin rpy="0 0 0" xyz="0 0 0" />
      <mass value="0.1" />
      <inertia ixx="0.0001" ixy="0.0" ixz="0.0" iyy="0.0001" iyz="0.0" izz="0.0001" />
    </inertial>
  </link>
  <joint name="lidar_joint" type="fixed">
    <parent link="body_link" />
    <child link="lidar_link" />
    <origin rpy="0 0 0" xyz="0 0 0.2" />
  </joint>
  <link name="lidar_link">
    <inertial>
      <origin rpy="0 0 0" xyz="0 0 0" />
      <mass value="0.1" />
      <inertia ixx="0.0001" ixy="0.0" ixz="0.0" iyy="0.0001" iyz="0.0" izz="0.0001" />
    </inertial>
    
    
  </link>
  <joint name="camera_joint" type="fixed">
    <parent link="body_link" />
    <child link="camera_link" />
    <origin rpy="0 0 0" xyz="0.05 -0.1 0.1" />
  </joint>
  <link name="camera_link">
    <inertial>
      <origin rpy="0 0 0" xyz="0 0 0" />
      <mass value="0.1" />
      <inertia ixx="0.0001" ixy="0.0" ixz="0.0" iyy="0.0001" iyz="0.0" izz="0.0001" />
    </inertial>
    
    
  </link>
  <joint name="depth_camera_joint" type="fixed">
    <parent link="body_link" />
    <child link="depth_camera_link" />
    <origin rpy="0 0 0" xyz="0.05 0.1 0.1" />
  </joint>
  <link name="depth_camera_link">
    <inertial>
      <origin rpy="0 0 0" xyz="0 0 0" />
      <mass value="0.1" />
      <inertia ixx="0.0001" ixy="0.0" ixz="0.0" iyy="0.0001" iyz="0.0" izz="0.0001" />
    </inertial>
    
    
  </link>
  <ros2_control name="diffbot" type="system">
    <hardware>
      <plugin>topic_based_ros2_control/TopicBasedSystem</plugin>
      <param name="joint_commands_topic">/diffbot/joint_command</param>
      <param name="joint_states_topic">/diffbot/joint_states</param>
      <param name="sum_wrapped_joint_states">true</param>
      
      <param name="ground_truth_topic">/diffbot/ground_truth</param>
    </hardware>
    <joint name="left_wheel_joint">
      <command_interface name="velocity">
        <param name="min">-1</param>
        <param name="max">1</param>
      </command_interface>
      <state_interface name="position" />
      <state_interface name="velocity" />
      <state_interface name="effort" />
    </joint>
    <joint name="right_wheel_joint">
      <command_interface name="velocity">
        <param name="min">-1</param>
        <param name="max">1</param>
      </command_interface>
      <state_interface name="position" />
      <state_interface name="velocity" />
      <state_interface name="effort" />
    </joint>
  </ros2_control>
  
  <simulation>
    <sensor name="lidar_link" type="lidar">
      <update_rate>30</update_rate>
      <ray>
        <scan>
          <horizontal>
            <samples>400</samples>
            <resolution>1</resolution>
            <min_angle>-3.1415</min_angle>
            <max_angle>3.1415</max_angle>
          </horizontal>
        </scan>
        <range>
          <min>0.05</min>
          <max>20.0</max>
          <resolution>0.01</resolution>
        </range>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.01</stddev>
        </noise>
      </ray>
      <topicName>/lidar/scan</topicName>
      <frameName>lidar_link</frameName>
    </sensor>
    <sensor name="camera_link" type="camera">
      <update_rate>10.0</update_rate>
      <horizontal_fov>1.3962634</horizontal_fov>
      <image>
        <width>800</width>
        <height>600</height>
      </image>
      <clip>
        <near>0.02</near>
        <far>300</far>
      </clip>
      <cameraName>/camera</cameraName>
      <imageTopicName>image_raw</imageTopicName>
      <cameraInfoTopicName>camera_info</cameraInfoTopicName>
      <frameName>camera_link</frameName>
    </sensor>
    <sensor name="depth_camera_link" type="depth_camera">
      <update_rate>10.0</update_rate>
      <horizontal_fov>1.3962634</horizontal_fov>
      <image>
        <width>320</width>
        <height>240</height>
      </image>
      <clip>
        <near>0.02</near>
        <far>300</far>
      </clip>
      <cameraName>/depth_camera</cameraName>
      <imageTopicName>depth_image_raw</imageTopicName>
      <cameraInfoTopicName>depth_camera_info</cameraInfoTopicName>
      <frameName>depth_camera_link</frameName>
    </sensor>
  </simulation>
</robot>