<!-- |    This document was autogenerated by xacro from /home/unity/colcon_ws/install/servo_demo_description/share/servo_demo_description/robots/servo_demo.urdf.xacro | -->
<!-- |    EDITING THIS FILE BY HAND IS NOT RECOMMENDED                                 | -->
<!-- =================================================================================== -->
<robot name="ServoDemo">
  <!-- =============== ros2_control =============== -->
  <ros2_control name="ServoDemo" type="system">
    <hardware>
      <plugin>topic_based_ros2_control/TopicBasedSystem</plugin>
      <param name="joint_commands_topic">/ServoDemo/joint_command</param>
      <param name="joint_states_topic">/ServoDemo/joint_states</param>
      <!-- sum_wrapped_joint_states は使わない: スポーン直後の過渡状態を
             ラップ回転と誤検出して恒久オフセットをラッチし、以後の指令全体が
             ずれてアームがリミットへ誘導される (実測 ~2.1 rad オフセット)。
             この腕は連続回転しないため不要。 -->
    </hardware>
    <joint name="ideal_joint">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="cheap_joint">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
  </ros2_control>
  <!-- =============== Servo motor model (v0.9.2) =============== -->
  <!--
      Cheap SG90-like servo. Parameters stay inside the range validated by
      ServoPendulumTests/ServoDemoCapture (Kd, transmission K/D scaled to
      this arm) so the ringing decays into stiction instead of blowing up:

      motor:
        p_gain 3.0 / d_gain 0.01 : underdamped PD (zeta ~ 0.09)
                                   -> ~5 Hz ringing for 1-2 s after steps
        torque_limit 0.18 N*m    : SG90 stall torque (~1.8 kgf*cm), SI units
                                   (the rotor model works in rad internally)
        inertia 2e-3 kg*m^2      : reflected rotor inertia through the gears
      friction (motor/gearbox side, Stribeck):
        static 0.02 > dynamic 0.01, stribeck_velocity 0.1
                                   -> stick-slip judder during slow sweeps
                                      and a sticky dead zone near the goal
      backlash:
        width 0.052 rad (~3 deg total) plastic gear play.
        NOTE: transmission stiffness is limited by the 50 Hz physics rate.
        The rotor and the joint exchange state with one physics step of
        delay, so the coupled mode must stay below ~1/dt: the physically
        realistic K=400 N*m/rad self-oscillates. K=2 is stable and still
        keeps the gap visible (static sag tau_g/K ~ 0.025 rad ~ half gap).
        static friction is kept small: the Karnopp stick band around the
        saturated stall torque (|tau_max - K*windup| < static) otherwise
        deadlocks the rotor against the wound-up transmission.
    -->
  <!-- stick-slip visibility: the judder amplitude during slow sweeps is
         roughly (static - dynamic) / K_series with
         K_series = 1/(1/p_gain + 1/stiffness). p=4, static=0.06, dyn=0.015
         gives ~34 mrad jumps every ~0.3 s at the demo sweep speed
         (0.11 rad/s) - clearly visible - while targets stay reachable
         (steady PD error tau_s/p ~ 15 mrad, no Karnopp deadlock). -->
  <servo_model joint="cheap_joint">
    <motor d_gain="0.02" inertia="2e-3" p_gain="4.0" torque_limit="0.18"/>
    <friction dynamic="0.015" static="0.06" stribeck_velocity="0.1" viscous="0.08"/>
    <backlash damping="0.5" stiffness="2.0" width="0.09"/>
  </servo_model>
  <material name="stand_gray">
    <color rgba="0.35 0.35 0.35 1.0"/>
  </material>
  <material name="servo_blue">
    <color rgba="0.15 0.4 1.0 1.0"/>
  </material>
  <material name="servo_red">
    <color rgba="1.0 0.2 0.15 1.0"/>
  </material>
  <material name="arm_white">
    <color rgba="0.92 0.92 0.92 1.0"/>
  </material>
  <!-- Root link named "world" is fixed (immovable) by the simulator -->
  <link name="world">
    <inertial>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <mass value="0.001"/>
      <inertia ixx="0.00001" ixy="0.0" ixz="0.0" iyy="0.00001" iyz="0.0" izz="0.00001"/>
    </inertial>
  </link>
  <joint name="stand_joint" type="fixed">
    <parent link="world"/>
    <child link="stand_link"/>
    <origin rpy="0 0 0" xyz="0 0 0.15"/>
  </joint>
  <link name="stand_link">
    <inertial>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <mass value="2.0"/>
      <inertia ixx="0.02" ixy="0.0" ixz="0.0" iyy="0.02" iyz="0.0" izz="0.02"/>
    </inertial>
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <box size="0.02 0.24 0.30"/>
      </geometry>
      <material name="stand_gray"/>
    </visual>
    <collision>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <box size="0.02 0.24 0.30"/>
      </geometry>
    </collision>
  </link>
  <joint name="ideal_mount_joint" type="fixed">
    <parent link="stand_link"/>
    <child link="ideal_servo_link"/>
    <origin rpy="0 0 0" xyz="0.02 -0.09 0.10"/>
  </joint>
  <link name="ideal_servo_link">
    <inertial>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <mass value="0.02"/>
      <inertia ixx="0.00001" ixy="0.0" ixz="0.0" iyy="0.00001" iyz="0.0" izz="0.00001"/>
    </inertial>
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <box size="0.03 0.04 0.04"/>
      </geometry>
      <material name="servo_blue"/>
    </visual>
    <collision>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <box size="0.03 0.04 0.04"/>
      </geometry>
    </collision>
  </link>
  <!-- The arm link geometry points straight DOWN (-z) at q = 0, i.e. the
         rest pose is the gravity equilibrium in the middle of the joint
         range, far away from the limits (a link resting exactly ON a limit
         can jam in this engine build). The joint frame itself is NOT
         rotated - rotated joint frames confused the runtime importer (the
         servo model then read a locked DOF).
         The swing axis is x (the direction the servo boxes protrude), so
         the arm swings PARALLEL to the stand plate; swinging about y would
         drive the tip into the plate at |q|~0.19. -->
  <joint name="ideal_joint" type="revolute">
    <parent link="ideal_servo_link"/>
    <child link="ideal_arm_link"/>
    <origin rpy="0 0 0" xyz="0.025 0 0"/>
    <axis xyz="1 0 0"/>
    <!-- effort feeds Unity xDrive.forceLimit, which acts on the degree-based
           drive: real torque limit [N*m] = effort * pi / 180. 10.3 = 0.18 N*m
           (SG90 stall). The cheap joint's motor limit is set in SI via
           <servo_model><motor torque_limit>.
           Joint limits: +-1.7 rad keeps the hanging pose (+-1.57) off the
           limit surface (a link resting exactly ON a limit can jam in this
           engine build; ServoJointModel carries an un-jam workaround) and
           stops the arm before the tip can swing behind the stand plate
           (tip-plate collision starts around 1.9 rad). -->
    <limit effort="10.313240312354818" lower="-1.7" upper="1.7" velocity="8.0"/>
    <!-- Baseline (ideal) position servo: P = 3 N*m/rad with near-critical
           damping D = 0.08 N*m/(rad/s) (zeta ~ 0.9 for the arm inertia), so
           the reference joint tracks smoothly with no overshoot or ringing.
           P cannot be raised much further: the plain xDrive obeys the same
           50 Hz discrete stability limit as the transmission (K=20 was
           measured to self-oscillate at ~+-0.1 rad).
           The engine scales rotational drive stiffness/damping by pi/180
           (measured from static sag), so SI values are written with a
           x180/pi compensation, like effort above.
           For cheap_joint the servo model handles this internally. -->
    <drive damping="4.583662361046586" stiffness="171.88733853924697"/>
  </joint>
  <link name="ideal_arm_link">
    <inertial>
      <origin rpy="0 0 0" xyz="0 0 -0.113"/>
      <mass value="0.045"/>
      <inertia ixx="0.000024" ixy="0.0" ixz="0.0" iyy="0.000024" iyz="0.0" izz="0.000003"/>
    </inertial>
    <visual>
      <origin rpy="0 0 0" xyz="0 0 -0.06"/>
      <geometry>
        <cylinder length="0.12" radius="0.004"/>
      </geometry>
      <material name="arm_white"/>
    </visual>
    <visual>
      <origin rpy="0 0 0" xyz="0 0 -0.12"/>
      <geometry>
        <sphere radius="0.012"/>
      </geometry>
      <material name="servo_blue"/>
    </visual>
    <collision>
      <origin rpy="0 0 0" xyz="0 0 -0.12"/>
      <geometry>
        <sphere radius="0.012"/>
      </geometry>
    </collision>
  </link>
  <joint name="cheap_mount_joint" type="fixed">
    <parent link="stand_link"/>
    <child link="cheap_servo_link"/>
    <origin rpy="0 0 0" xyz="0.02 0.09 0.10"/>
  </joint>
  <link name="cheap_servo_link">
    <inertial>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <mass value="0.02"/>
      <inertia ixx="0.00001" ixy="0.0" ixz="0.0" iyy="0.00001" iyz="0.0" izz="0.00001"/>
    </inertial>
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <box size="0.03 0.04 0.04"/>
      </geometry>
      <material name="servo_red"/>
    </visual>
    <collision>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <box size="0.03 0.04 0.04"/>
      </geometry>
    </collision>
  </link>
  <!-- The arm link geometry points straight DOWN (-z) at q = 0, i.e. the
         rest pose is the gravity equilibrium in the middle of the joint
         range, far away from the limits (a link resting exactly ON a limit
         can jam in this engine build). The joint frame itself is NOT
         rotated - rotated joint frames confused the runtime importer (the
         servo model then read a locked DOF).
         The swing axis is x (the direction the servo boxes protrude), so
         the arm swings PARALLEL to the stand plate; swinging about y would
         drive the tip into the plate at |q|~0.19. -->
  <joint name="cheap_joint" type="revolute">
    <parent link="cheap_servo_link"/>
    <child link="cheap_arm_link"/>
    <origin rpy="0 0 0" xyz="0.025 0 0"/>
    <axis xyz="1 0 0"/>
    <!-- effort feeds Unity xDrive.forceLimit, which acts on the degree-based
           drive: real torque limit [N*m] = effort * pi / 180. 10.3 = 0.18 N*m
           (SG90 stall). The cheap joint's motor limit is set in SI via
           <servo_model><motor torque_limit>.
           Joint limits: +-1.7 rad keeps the hanging pose (+-1.57) off the
           limit surface (a link resting exactly ON a limit can jam in this
           engine build; ServoJointModel carries an un-jam workaround) and
           stops the arm before the tip can swing behind the stand plate
           (tip-plate collision starts around 1.9 rad). -->
    <limit effort="10.313240312354818" lower="-1.7" upper="1.7" velocity="8.0"/>
    <!-- Baseline (ideal) position servo: P = 3 N*m/rad with near-critical
           damping D = 0.08 N*m/(rad/s) (zeta ~ 0.9 for the arm inertia), so
           the reference joint tracks smoothly with no overshoot or ringing.
           P cannot be raised much further: the plain xDrive obeys the same
           50 Hz discrete stability limit as the transmission (K=20 was
           measured to self-oscillate at ~+-0.1 rad).
           The engine scales rotational drive stiffness/damping by pi/180
           (measured from static sag), so SI values are written with a
           x180/pi compensation, like effort above.
           For cheap_joint the servo model handles this internally. -->
    <drive damping="4.583662361046586" stiffness="171.88733853924697"/>
  </joint>
  <link name="cheap_arm_link">
    <inertial>
      <origin rpy="0 0 0" xyz="0 0 -0.113"/>
      <mass value="0.045"/>
      <inertia ixx="0.000024" ixy="0.0" ixz="0.0" iyy="0.000024" iyz="0.0" izz="0.000003"/>
    </inertial>
    <visual>
      <origin rpy="0 0 0" xyz="0 0 -0.06"/>
      <geometry>
        <cylinder length="0.12" radius="0.004"/>
      </geometry>
      <material name="arm_white"/>
    </visual>
    <visual>
      <origin rpy="0 0 0" xyz="0 0 -0.12"/>
      <geometry>
        <sphere radius="0.012"/>
      </geometry>
      <material name="servo_red"/>
    </visual>
    <collision>
      <origin rpy="0 0 0" xyz="0 0 -0.12"/>
      <geometry>
        <sphere radius="0.012"/>
      </geometry>
    </collision>
  </link>
</robot>
